{
  "info": {
    "name": "Fuel Route Optimizer",
    "description": "Requests for the fuel route API. Run them in order: request 2 relies on request 1 being cached.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Long route",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has total_fuel_cost, fuel_stops and map_url\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"total_fuel_cost\");",
              "    pm.expect(body.fuel_stops).to.be.an(\"array\");",
              "    pm.expect(body).to.have.property(\"map_url\");",
              "});",
              "pm.test(\"Has several fuel stops\", () => pm.expect(pm.response.json().fuel_stops.length).to.be.above(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}"
        },
        "url": "{{base_url}}/api/route/",
        "description": "New York to Los Angeles. Expect 200 and several fuel stops."
      }
    },
    {
      "name": "2. Same long route again",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has total_fuel_cost, fuel_stops and map_url\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"total_fuel_cost\");",
              "    pm.expect(body.fuel_stops).to.be.an(\"array\");",
              "    pm.expect(body).to.have.property(\"map_url\");",
              "});",
              "pm.test(\"Served from cache\", () => pm.expect(pm.response.json().external_api_calls).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"New York, NY\",\n  \"finish\": \"Los Angeles, CA\"\n}"
        },
        "url": "{{base_url}}/api/route/",
        "description": "Same body as request 1. Expect 200 and external_api_calls = 0 (served from cache)."
      }
    },
    {
      "name": "3. Short route (under 500 miles)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Has total_fuel_cost, fuel_stops and map_url\", () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"total_fuel_cost\");",
              "    pm.expect(body.fuel_stops).to.be.an(\"array\");",
              "    pm.expect(body).to.have.property(\"map_url\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"St. Louis, MO\"\n}"
        },
        "url": "{{base_url}}/api/route/",
        "description": "Chicago to St. Louis, short enough for one tank. Expect 200."
      }
    },
    {
      "name": "4. Map",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is HTML\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/route/map/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "route",
            "map",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        },
        "description": "Leaflet map for the long route. Expect 200 and an HTML page."
      }
    },
    {
      "name": "5. Missing field",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\"\n}"
        },
        "url": "{{base_url}}/api/route/",
        "description": "No finish in the body. Expect 400."
      }
    },
    {
      "name": "6. Outside USA",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Toronto, Canada\",\n  \"finish\": \"Chicago, IL\"\n}"
        },
        "url": "{{base_url}}/api/route/",
        "description": "Start in Canada. Expect 400."
      }
    },
    {
      "name": "7. Invalid JSON body",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "not json"
        },
        "url": "{{base_url}}/api/route/",
        "description": "Body is not JSON. Expect 400."
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    }
  ]
}
